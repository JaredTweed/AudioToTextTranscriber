<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.JaredTweed.AudioToTextTranscriber</id>
  <name>Audio-to-Text Transcriber</name>
  <summary>Convert audio to text locally</summary>

  <developer id="io.github.jaredtweed">
    <name>Jared Tweed</name>
  </developer>
  <launchable type="desktop-id">io.github.JaredTweed.AudioToTextTranscriber.desktop</launchable>

  <!-- Licensing -->
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <!-- Project links -->
  <url type="homepage">https://github.com/JaredTweed/AudioToTextTranscriber</url>
  <url type="bugtracker">https://github.com/JaredTweed/AudioToTextTranscriber/issues</url>
  <url type="vcs-browser">https://github.com/JaredTweed/AudioToTextTranscriber</url>

  <!-- Description -->
  <description>
    <p>
      Audio-to-Text Transcriber is a lightweight GTK application that
      converts recordings to plain text entirely offline,
      using the fast whisper.cpp backend.
    </p>
    <p>
      Drag-and-drop one or many audio files, pick a Whisper model
      (downloaded on demand), and receive instant transcripts with
      optional timestamps. No cloud service is required.
    </p>
  </description>

